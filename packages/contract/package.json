{
  "name": "@fortrip/agent-contract",
  "version": "3.0.0",
  "license": "Apache-2.0",
  "description": "The contract of Fortrip's agent API (https://api.fortrip.ai/v1) and its MCP server: limits, paths, request and response schemas, error codes and field rules.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FortripEngineering/fortrip.git",
    "directory": "packages/contract"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./guest-name": {
      "types": "./dist/guest-name.d.ts",
      "import": "./dist/guest-name.js"
    }
  },
  "files": ["dist", "NOTICE"],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "embed-guide": "node --import tsx scripts/embed-guide.ts",
    "build": "pnpm embed-guide && tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --import tsx --test test/*.test.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "zod": "4.4.3"
  }
}
