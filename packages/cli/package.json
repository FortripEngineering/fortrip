{
  "name": "fortrip",
  "version": "3.1.0",
  "license": "Apache-2.0",
  "description": "Search, price and book Fortrip hotels from the terminal or an AI agent.",
  "mcpName": "io.github.FortripEngineering/fortrip",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FortripEngineering/fortrip.git",
    "directory": "packages/cli"
  },
  "bin": {
    "fortrip": "dist/cli.js"
  },
  "files": ["dist", "README.md", "NOTICE", "THIRD-PARTY-NOTICES"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1"
  },
  "devDependencies": {
    "@fortrip/agent-contract": "workspace:*",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "zod": "4.4.3"
  }
}
