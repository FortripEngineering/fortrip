{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.FortripEngineering/fortrip",
  "title": "Fortrip",
  "description": "Search hotels worldwide, compare live room rates, book and pay securely, and cancel bookings.",
  "version": "1.4.23",
  "websiteUrl": "https://fortrip.ai",
  "icons": [
    {
      "src": "https://fortrip.ai/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/FortripEngineering/fortrip",
    "source": "github",
    "id": "1415393587"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "fortrip",
      "version": "6.0.0-rc.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.fortrip.ai/"
    }
  ]
}
